# ============ Hermes gateway (server-side only, never sent to the browser) ============

# Base URL of the Hermes container's HTTP API, e.g. http://localhost:8642
# or http://hermes-local-agent:8642 inside docker compose. REQUIRED.
HERMES_API_URL=

# API shape: "openai" (POST /v1/chat/completions, streaming) or "custom" ({message} -> {reply}).
HERMES_API_MODE=openai

# For custom mode only — chat endpoint path appended to HERMES_API_URL.
HERMES_CHAT_PATH=/chat

# Bearer token for the Hermes API server (API_SERVER_KEY on the Hermes side).
HERMES_API_KEY=

# openai mode — model name to request (Hermes treats it as its configured profile).
HERMES_MODEL=hermes-agent

# Prefix for X-Hermes-Session-Key so web + Slack share the agent's per-user memory.
# Must mirror the scheme the Slack bridge uses.
HERMES_SESSION_KEY_PREFIX=agent:main:slack:dm:

# ============ Slack sign-in ============
# Gate the UI behind "Sign in with Slack". Requires a Slack app with OpenID
# Connect and redirect URL https://<host>/api/auth/callback/slack
#
# SECURITY: "false" is for single-user local development ONLY — it makes every
# API route open and every visitor share one identity. The Dockerfile defaults
# to "true" for deployments; keep it that way on any exposed server.
NEXT_PUBLIC_AUTH_ENABLED=false
AUTH_SECRET=            # openssl rand -base64 33
AUTH_SLACK_ID=          # Slack app Client ID
AUTH_SLACK_SECRET=      # Slack app Client Secret

# Approval buttons need the agent's /v1/runs API. Default "off" (legacy
# chat-completions path: rich tool/thinking stream, but no approval
# prompts). Set "auto" to prefer runs mode when the agent image emits the
# full event set (tool progress + deltas + approval events).
# HERMES_RUNS_MODE=off

# Shared secret for server-to-server calls from the Attendee UI (timeclock).
# Same value in BOTH apps' .env.local. Leave empty to disable the integration.
INTERNAL_TOKEN=

# Where this app reaches the Attendee UI over the Docker network (Team page).
TIMECLOCK_URL=http://attendee-ui:3000
# Agent-readable team digest (who's working/standby + open tasks), regenerated
# every few minutes. Default: <DRIVE_MOUNT_DIR>/SUPERPIXEL/TEAM-STATUS.md
# TEAM_STATUS_PATH=
# Public URL of this app (needed behind a proxy so OAuth redirects are correct):
AUTH_URL=

# ============ Storage & filesystem ============

# Where all server state lives (projects, chats, conversations, attachments, thumbs).
# In Docker this is /app/data on a volume; locally defaults to ./data.
DATA_DIR=

# The rclone Google Drive mount root (shared with the agent container).
DRIVE_MOUNT_DIR=/gdrive

# Agent output dirs served for chat download buttons (comma-separated).
# Requires the same volume mounted read-only into this container.
AGENT_DATA_DIRS=/opt/data

# Optional shared agent workspace volume (see docs/DEPLOY-REMOTE.md).
AGENT_WORKSPACE_DIR=/workspace
