# Hermes gateway connection (server-side only — never exposed to the browser)
# Base URL of your Hermes container's HTTP API:
HERMES_API_URL=http://103.49.239.127:8000

# The chat endpoint path, appended to HERMES_API_URL:
HERMES_CHAT_PATH=/chat

# API shape: "openai" (POST /v1/chat/completions) or "custom" (simple {message} -> {reply})
HERMES_API_MODE=custom

# Optional bearer token / API key. Leave blank if the endpoint is open.
HERMES_API_KEY=

# For openai mode only — model name to request:
HERMES_MODEL=hermes

# --- Slack sign-in (Phase 1, ROADMAP.md) ---
# Gate the UI behind "Sign in with Slack". Requires a Slack app with OpenID
# Connect and redirect URL https://<host>/api/auth/callback/slack
NEXT_PUBLIC_AUTH_ENABLED=false
AUTH_SECRET=            # openssl rand -base64 33
AUTH_SLACK_ID=          # Slack app Client ID
AUTH_SLACK_SECRET=      # Slack app Client Secret
